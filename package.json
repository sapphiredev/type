{
	"name": "@sapphire/type",
	"version": "2.6.0",
	"description": "A type detection utility for JavaScript",
	"author": "@sapphire",
	"license": "MIT",
	"type": "module",
	"main": "dist/index.mjs",
	"module": "dist/index.mjs",
	"types": "dist/index.d.mts",
	"exports": {
		"types": "./dist/index.d.mts",
		"import": "./dist/index.mjs"
	},
	"sideEffects": false,
	"homepage": "https://github.com/sapphiredev/type",
	"scripts": {
		"install": "node-pre-gyp install --fallback-to-build",
		"build": "yarn gyp:configure && yarn gyp:build && yarn gyp:package && yarn ts:build",
		"clean": "node scripts/clean.mjs",
		"test": "yarn gyp:configure && yarn gyp:build && vitest run",
		"lint": "eslint src tests --ext ts --fix",
		"prettier": "prettier --ignore-path=.prettierignore",
		"prepack": "yarn build",
		"ts:build": "tsdown",
		"gyp:build-from-source": "node-pre-gyp install --fallback-to-build --build-from-source",
		"gyp:configure": "node-pre-gyp configure",
		"gyp:build": "node-pre-gyp build",
		"gyp:package": "node-pre-gyp package",
		"bump": "cliff-jumper",
		"check-update": "cliff-jumper --dry-run"
	},
	"binary": {
		"module_name": "type",
		"module_path": "./prebuild/{module_name}-{node_abi}-{platform}-{arch}-{libc}-{libc_version}/",
		"host": "https://github.com/sapphiredev/type/releases/download/",
		"remote_path": "v{version}",
		"package_name": "{module_name}-v{version}-{node_abi}-{platform}-{arch}-{libc}-{libc_version}.tar.gz",
		"pkg_path": "."
	},
	"dependencies": {
		"@discordjs/node-pre-gyp": "^0.4.5",
		"nan": "^2.30.0",
		"tslib": "^2.9.1"
	},
	"devDependencies": {
		"@actions/core": "^3.0.1",
		"@actions/github": "^9.1.1",
		"@actions/glob": "^0.7.0",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@favware/cliff-jumper": "^6.1.0",
		"@favware/npm-deprecate": "^2.0.0",
		"@sapphire/eslint-config": "^6.0.0",
		"@sapphire/prettier-config": "^3.0.0",
		"@sapphire/ts-config": "^5.0.3",
		"@types/node": "^24.19.2",
		"@typescript-eslint/eslint-plugin": "^8.72.2",
		"@typescript-eslint/parser": "^8.72.2",
		"@vitest/coverage-v8": "^5.1.0",
		"cz-conventional-changelog": "^3.3.0",
		"discord.js": "^14.28.1",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.7",
		"lint-staged": "^17.6.0",
		"prettier": "^3.10.1",
		"tsdown": "^0.23.7",
		"tsup": "^8.5.1",
		"typedoc": "^0.26.11",
		"typedoc-json-parser": "^10.2.0",
		"typescript": "~6.0.3",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	},
	"files": [
		"lib",
		"dist",
		"!dist/*.tsbuildinfo",
		"binding.gyp"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sapphiredev/type.git"
	},
	"engines": {
		"node": ">=v12",
		"npm": ">=7"
	},
	"keywords": [
		"@sapphire/type",
		"bot",
		"typescript",
		"ts",
		"discord",
		"sapphire",
		"standalone"
	],
	"bugs": {
		"url": "https://github.com/sapphiredev/type/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"resolutions": {
		"ansi-regex": "^5.0.1",
		"minimist": "^1.2.8"
	},
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional"
		]
	},
	"lint-staged": {
		"*": "prettier --ignore-unknown --write",
		"*.{mjs,js,ts}": "eslint --fix"
	},
	"config": {
		"commitizen": {
			"path": "./node_modules/cz-conventional-changelog"
		}
	},
	"gypfile": true,
	"packageManager": "yarn@4.18.1"
}
